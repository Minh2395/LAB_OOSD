<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Replace Server, Database and authentication as needed:
      - For Windows auth: use Integrated Security=True
      - For SQL auth: use User Id=sa;Password=yourPassword;
    -->
    <add name="QuanLyTour"
         connectionString="Server=.;Database=QuanLyTour;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>